{
    "backbone": "resnet18",
    "num_node_classes": 16,
    "num_edge_classes": 1,
    "dilation": false,
    "position_embedding": "sine",
    "classes": [
        "table",
        "table column",
        "table row",
        "table column header",
        "table projected row header",
        "table spanning cell",
        "table caption",
        "table footer",
        "table rotated",
        "table column rotated",
        "table row rotated",
        "table column header rotated",
        "table projected row header rotated",
        "table spanning cell rotated",
        "table caption rotated",
        "table footer rotated",
        "no object"
    ],
    "enc_layers": 6,
    "dec_layers": 6,
    "node_embed_hidden_layers": 1,
    "node_embed_hidden_dim": 256,
    "edge_embed_hidden_layers": 2,
    "edge_embed_hidden_dim": 256,
    "bbox_embed_hidden_layers": 3,
    "bbox_embed_hidden_dim": 256,
    "pre_adj_dim": 64,
    "dim_feedforward": 2048,
    "hidden_dim": 256,
    "nheads": 8,
    "num_queries": 250,
    "pre_norm": true,
    "masks": false
}
