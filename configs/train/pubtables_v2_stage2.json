            "val_transform": "eval"
        },
        {
            "data_root_dir": "./data/PubTables-v2/Full Documents/",
            "img_extension": ".jpg",
            "train_page_list": "configs/data/pubtables_v2/full_documents_no_objects_train.txt",
            "train_max_size": 2000,
            "val_max_size": 0,
            "train_transform": "train",
            "val_transform": "eval"
        },
        {
            "data_root_dir": "./data/PubTables-v2/Single Pages/",
            "img_extension": ".jpg",
            "train_page_list": "configs/data/pubtables_v2/long_tables_train.txt",
            "val_page_list": "configs/data/pubtables_v2/long_tables_val.txt",
            "val_max_size": 250,
            "train_transform": "train",
            "val_transform": "eval"
        }
    ]
